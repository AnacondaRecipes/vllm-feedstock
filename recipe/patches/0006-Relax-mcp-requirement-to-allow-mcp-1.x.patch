From c4e5b3a324a27587aed43f17201e1b0cc1de7893 Mon Sep 17 00:00:00 2001
From: Andrew Howe <ahowe@anaconda.com>
Date: Thu, 29 Oct 2026 10:00:15 -0400
Subject: [PATCH 6/7] Relax mcp requirement to allow mcp 1.x

huggingface_hub 1.x declares mcp<2.0.0 in its optional 'mcp' extra, which
conda packaging turns into a run_constrained entry. Requiring mcp>=2.0
therefore makes vllm and huggingface_hub impossible to install together.

vLLM only uses mcp.ClientSession and mcp.client.sse.sse_client, plus
attributes of the InitializeResult, ListToolsResult and CallToolResult
objects, all of which are available in both mcp 1.x and 2.x.
---
 requirements/common.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/requirements/common.txt b/requirements/common.txt
index 094b751..a22e9d3 100644
--- a/requirements/common.txt
+++ b/requirements/common.txt
@@ -51,7 +51,7 @@ setproctitle # Used to set process names for better debugging and monitoring
 oss-harmony >= 0.0.11  # Required for gpt-oss; includes embedded vocabularies
 anthropic >= 0.71.0
 model-hosting-container-standards >= 0.1.14, < 1.0.0
-mcp >= 2.0.0, < 3.0.0
+mcp >= 1.9.4, < 3.0.0
 opentelemetry-sdk >= 1.27.0
 opentelemetry-api >= 1.27.0
 opentelemetry-exporter-otlp >= 1.27.0
